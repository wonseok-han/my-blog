{
  "description": "블로그 작성 요청을 LangGraph 워크플로에 전달합니다.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/blog_workflow_entry.mjs\"",
            "statusMessage": "블로그 워크플로 진입점을 준비하는 중",
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
